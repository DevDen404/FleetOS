{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build FleetOS API",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"build",
				"FleetOS.slnx"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Build frontend from root",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"frontend",
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Build frontend with npm cmd",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"--prefix",
				"frontend",
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Lint FleetOS frontend",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"--prefix",
				"frontend",
				"run",
				"lint"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Build FleetOS API project",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"build",
				"FleetOS.Api\\FleetOS.Api.csproj",
				"--no-restore"
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}